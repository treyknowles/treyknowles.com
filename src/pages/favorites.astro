---
import BaseLayout from '../layouts/BaseLayout.astro';

const favorites = {
  books: [],
  articles: [],
  stuff: [],
};
---

<BaseLayout
  title="Favorites"
  description="Books, tools, podcasts, and gear I actually use and recommend."
>
  <div class="container">
    <header>
      <h1>Favs</h1>
      <p>Things I recommend!</p>
    </header>

    <div class="sections">
      <section>
        <h2>Books</h2>
        <ul>
          {favorites.books.map(item => (
            <li>
              <div class="item-title">{item.title} <span class="author">by {item.author}</span></div>
              {item.note && <p>{item.note}</p>}
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Articles</h2>
        <ul>
          {favorites.articles.map(item => (
            <li>
              <div class="item-title">{item.title}</div>
              {item.note && <p>{item.note}</p>}
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Stuff</h2>
        <ul>
          {favorites.stuff.map(item => (
            <li>
              <div class="item-title">{item.title}</div>
              {item.note && <p>{item.note}</p>}
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }

  header {
    margin-bottom: 3rem;
  }

  h1 {
    font-size: 2.5rem;
    font-weight: 400;
    font-family: 'Permanent Marker', cursive;
    letter-spacing: normal;
    color: var(--color-text);
    margin: 0 0 0.5rem;
  }

  header p {
    font-size: 0.9375rem;
    color: var(--color-muted);
    margin: 0;
  }

  .sections {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  h2 {
    font-size: 1.5rem;
    font-weight: 400;
    font-family: 'Permanent Marker', cursive;
    text-transform: none;
    letter-spacing: normal;
    color: var(--color-text);
    margin: 0 0 1.25rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  li {
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  li:first-child {
    border-top: 1px solid var(--color-border);
  }

  .item-title {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .author {
    font-weight: 400;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  li p {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.5;
  }
</style>
