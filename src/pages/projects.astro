---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = [
  { name: 'In Progress', description: 'TBD' },
  { name: 'In Progress', description: 'TBD' },
  { name: 'In Progress', description: 'TBD' },
  { name: 'In Progress', description: 'TBD' },
];
---

<BaseLayout
  title="Projects"
  description="Things I've worked on or been involved with."
>
  <div class="container">
    <header>
      <h1>Projects</h1>
      <p>Things I've worked on or been closely involved with.</p>
    </header>

    <div class="grid">
      {projects.map(project => (
        <ProjectCard
          name={project.name}
          description={project.description}
          url={project.url}
          tags={project.tags}
        />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }

  header {
    margin-bottom: 2.5rem;
  }

  h1 {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin: 0 0 0.5rem;
  }

  header p {
    font-size: 0.9375rem;
    color: var(--color-muted);
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
