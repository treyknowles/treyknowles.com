---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Trey Knowles"
  description="Trey Knowles — go-to-market for devtools. Early GTM at Vercel and Laravel."
>
  <div class="container">
    <div class="content">
      <!-- Photo placeholder -->
      <div class="photo-wrap">
        <div class="photo-placeholder">
          <span>Photo coming soon</span>
        </div>
      </div>

      <div class="bio">
        <p>TBD - UNDER CONSTRUCTION</p>
      </div>

      <!-- Career timeline -->
      <div class="timeline">
        <h2>Career</h2>

        <div class="timeline-list">

          <!-- Laravel -->
          <div class="company-group">
            <div class="group-content">
              <div class="group-header">
                <a class="company" href="https://laravel.com" target="_blank" rel="noopener">Laravel</a>
                <span class="period">Oct 2024 – Mar 2026</span>
              </div>
              <div class="role-list">
                <div class="role-item">
                  <p class="role">Director, Sales and RevOps</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Vercel -->
          <div class="company-group">
            <div class="group-content">
              <div class="group-header">
                <a class="company" href="https://vercel.com" target="_blank" rel="noopener">Vercel</a>
                <span class="period">Nov 2020 – Sep 2024</span>
              </div>
              <div class="role-list multi-role">
                <div class="role-item">
                  <span class="role-dot"></span>
                  <div class="role-details">
                    <p class="role">Director of GTM Operations</p>
                    <span class="period">Aug 2023 – Sep 2024</span>
                  </div>
                </div>
                <div class="role-item">
                  <span class="role-dot"></span>
                  <div class="role-details">
                    <p class="role">Senior Manager, Sales Operations</p>
                    <span class="period">Feb 2023 – Jul 2023</span>
                  </div>
                </div>
                <div class="role-item">
                  <span class="role-dot"></span>
                  <div class="role-details">
                    <p class="role">Director, Mid Market Sales</p>
                    <span class="period">Feb 2022 – Jan 2023</span>
                  </div>
                </div>
                <div class="role-item">
                  <span class="role-dot"></span>
                  <div class="role-details">
                    <p class="role">Account Executive</p>
                    <span class="period">Nov 2020 – Jan 2022</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Lambda School -->
          <div class="company-group">
            <div class="group-content">
              <div class="group-header">
                <a class="company" href="https://bloomtech.com" target="_blank" rel="noopener">Lambda School</a>
                <span class="period">May 2019 – Oct 2020</span>
              </div>
              <div class="role-list">
                <div class="role-item">
                  <p class="role">Manager, Sales Development</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Outreach -->
          <div class="company-group">
            <div class="group-content">
              <div class="group-header">
                <a class="company" href="https://outreach.io" target="_blank" rel="noopener">Outreach</a>
                <span class="period">Jan 2019 – May 2019</span>
              </div>
              <div class="role-list">
                <div class="role-item">
                  <p class="role">SDR</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Auth0 -->
          <div class="company-group">
            <div class="group-content">
              <div class="group-header">
                <a class="company" href="https://auth0.com" target="_blank" rel="noopener">Auth0</a>
                <span class="period">Sep 2017 – Nov 2018</span>
              </div>
              <div class="role-list">
                <div class="role-item">
                  <p class="role">Sales Operations</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Thomson Reuters -->
          <div class="company-group">
            <div class="group-content">
              <div class="group-header">
                <a class="company" href="https://thomsonreuters.com" target="_blank" rel="noopener">Thomson Reuters</a>
                <span class="period">Oct 2016 – Aug 2017</span>
              </div>
              <div class="role-list">
                <div class="role-item">
                  <p class="role">Sales Program Specialist</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Neo4j -->
          <div class="company-group">
            <div class="group-content">
              <div class="group-header">
                <a class="company" href="https://neo4j.com" target="_blank" rel="noopener">Neo Technology (Neo4j)</a>
                <span class="period">May 2015 – May 2016</span>
              </div>
              <div class="role-list">
                <div class="role-item">
                  <p class="role">Startup Community Manager</p>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }

.photo-wrap {
    margin-bottom: 2rem;
  }

  .photo-placeholder {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .photo-placeholder span {
    font-size: 0.625rem;
    color: var(--color-muted);
    text-align: center;
    padding: 0.5rem;
    line-height: 1.3;
  }

  .bio {
    margin-bottom: 3rem;
  }

  .bio p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  h2 {
    font-size: 2.5rem;
    font-weight: 400;
    font-family: 'Permanent Marker', cursive;
    text-transform: none;
    letter-spacing: normal;
    color: var(--color-text);
    margin: 0 0 1.5rem;
  }

  .timeline {
    margin-bottom: 3rem;
  }

  .company-group {
    margin-bottom: 2rem;
  }

  .group-content {
    flex: 1;
  }

  .group-header {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .company {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
  }

  .company:hover {
    text-decoration: underline;
  }

  .period {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .role-list {
    display: flex;
    flex-direction: column;
  }

  .role-list.multi-role {
    border-left: 1px solid var(--color-border);
    margin-left: 0.25rem;
    padding-left: 0;
  }

  .role-item {
    display: flex;
    gap: 0.75rem;
    padding: 0.35rem 0 0.35rem 0.75rem;
  }

  .role-list.multi-role .role-item {
    position: relative;
    padding-left: 1rem;
  }

  .role-dot {
    position: absolute;
    left: -0.3rem;
    top: 0.55rem;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: var(--color-border);
    flex-shrink: 0;
  }

  .role-details {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .role {
    font-size: 1.25rem;
    color: var(--color-muted);
    margin: 0;
  }

</style>
