---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Trey Knowles"
  description="Trey Knowles — go-to-market for devtools. Early GTM at Vercel and Laravel."
>
  <div class="container">
    <header>
      <h1>About</h1>
    </header>

    <div class="content">
      <!-- Photo placeholder -->
      <div class="photo-wrap">
        <div class="photo-placeholder">
          <span>Photo coming soon</span>
        </div>
      </div>

      <div class="bio">
        <p>TBD - UNDER CONSTRUCTION</p>
      </div>

      <!-- Career timeline -->
      <section class="timeline">
        <h2>Career</h2>

        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-header">
              <a class="company" href="https://laravel.com" target="_blank" rel="noopener">Laravel</a>
              <span class="period">Oct 2024 – Mar 2026</span>
            </div>
            <p class="role">Director, Sales and RevOps</p>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-header">
              <a class="company" href="https://vercel.com" target="_blank" rel="noopener">Vercel</a>
              <span class="period">Aug 2023 – Sep 2024</span>
            </div>
            <p class="role">Director of GTM Operations</p>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-header">
              <a class="company" href="https://vercel.com" target="_blank" rel="noopener">Vercel</a>
              <span class="period">Feb 2023 – Jul 2023</span>
            </div>
            <p class="role">Senior Manager, Sales Operations</p>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-header">
              <a class="company" href="https://vercel.com" target="_blank" rel="noopener">Vercel</a>
              <span class="period">Feb 2022 – Jan 2023</span>
            </div>
            <p class="role">Director, Mid Market Sales</p>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-header">
              <a class="company" href="https://vercel.com" target="_blank" rel="noopener">Vercel</a>
              <span class="period">Nov 2020 – Jan 2022</span>
            </div>
            <p class="role">Account Executive</p>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-header">
              <a class="company" href="https://bloomtech.com" target="_blank" rel="noopener">Lambda School</a>
              <span class="period">May 2019 – Oct 2020</span>
            </div>
            <p class="role">Manager, Sales Development</p>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-header">
              <a class="company" href="https://outreach.io" target="_blank" rel="noopener">Outreach</a>
              <span class="period">Jan 2019 – May 2019</span>
            </div>
            <p class="role">SDR</p>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-header">
              <a class="company" href="https://auth0.com" target="_blank" rel="noopener">Auth0</a>
              <span class="period">Sep 2017 – Nov 2018</span>
            </div>
            <p class="role">Sales Operations</p>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-header">
              <a class="company" href="https://thomsonreuters.com" target="_blank" rel="noopener">Thomson Reuters</a>
              <span class="period">Oct 2016 – Aug 2017</span>
            </div>
            <p class="role">Sales Program Specialist</p>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-header">
              <a class="company" href="https://neo4j.com" target="_blank" rel="noopener">Neo Technology (Neo4j)</a>
              <span class="period">May 2015 – May 2016</span>
            </div>
            <p class="role">Startup Community Manager</p>
          </div>
        </div>
      </section>

      <!-- Contact -->
      <section class="contact">
        <h2>Get in touch</h2>
        <p>
          I'm always happy to talk with founders navigating early GTM, or developers curious about the
          commercial side of developer tools.
        </p>
        <ul>
          <li><a href="https://twitter.com/treyknowles" target="_blank" rel="noopener">Twitter / X</a></li>
          <li><a href="https://linkedin.com/in/treyknowles" target="_blank" rel="noopener">LinkedIn</a></li>
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }

  header {
    margin-bottom: 2.5rem;
  }

  h1 {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin: 0;
  }

  .photo-wrap {
    margin-bottom: 2rem;
  }

  .photo-placeholder {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .photo-placeholder span {
    font-size: 0.625rem;
    color: var(--color-muted);
    text-align: center;
    padding: 0.5rem;
    line-height: 1.3;
  }

  .bio {
    margin-bottom: 3rem;
  }

  .bio p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  h2 {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin: 0 0 1.5rem;
  }

  .timeline {
    margin-bottom: 3rem;
  }

  .timeline-item {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    position: relative;
  }

  .timeline-marker {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 0.4rem;
  }

  .timeline-content {
    flex: 1;
  }

  .timeline-header {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .company {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
  }

  .company:hover {
    text-decoration: underline;
  }

  .period {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .role {
    font-size: 0.9375rem;
    color: var(--color-muted);
    margin: 0;
  }

  .contact {
    margin-bottom: 0;
  }

  .contact p {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.65;
    margin: 0 0 1rem;
  }

  .contact ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.25rem;
  }

  .contact li a {
    font-size: 0.875rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  .contact li a:hover {
    text-decoration: underline;
  }
</style>
