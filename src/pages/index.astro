---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Trey Knowles"
  description="Trey Knowles — go-to-market for devtools. Early GTM at Vercel and Laravel."
>
  <div class="container">
    <header>
      <h1>About</h1>
    </header>

    <div class="content">
      <!-- Photo placeholder -->
      <div class="photo-wrap">
        <div class="photo-placeholder">
          <span>Photo coming soon</span>
        </div>
      </div>

      <div class="bio">
        <p>
          I'm Trey Knowles — I help developer-focused companies build their go-to-market motion from the ground up.
          That means finding the first customers, figuring out what makes them successful, and turning those insights
          into a repeatable process.
        </p>
        <p>
          I'm drawn to the specific challenge of selling to developers: you can't push developers into anything,
          so you have to build products and experiences compelling enough that they pull themselves through the funnel.
          When it works, it's the most durable kind of growth there is.
        </p>
      </div>

      <!-- Career timeline -->
      <section class="timeline">
        <h2>Career</h2>

        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-header">
              <span class="company">Vercel</span>
              <span class="period">Early GTM</span>
            </div>
            <p>
              Joined Vercel early in their growth phase. Helped build out the enterprise motion for
              the platform that became the standard for frontend deployment. Worked closely with
              developers and engineering teams to translate a product-led growth engine into enterprise
              contracts without losing what made Vercel special.
            </p>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <div class="timeline-header">
              <span class="company">Laravel</span>
              <span class="period">Early GTM</span>
            </div>
            <p>
              Part of the early commercial team at Laravel — the PHP framework with one of the most
              passionate developer communities in the world. Helped commercialize a suite of tools
              (Forge, Vapor, Nova, Spark) while preserving the community-first ethos that made Laravel
              what it is.
            </p>
          </div>
        </div>
      </section>

      <!-- Contact -->
      <section class="contact">
        <h2>Get in touch</h2>
        <p>
          I'm always happy to talk with founders navigating early GTM, or developers curious about the
          commercial side of developer tools.
        </p>
        <ul>
          <li><a href="https://twitter.com/treyknowles" target="_blank" rel="noopener">Twitter / X</a></li>
          <li><a href="https://linkedin.com/in/treyknowles" target="_blank" rel="noopener">LinkedIn</a></li>
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }

  header {
    margin-bottom: 2.5rem;
  }

  h1 {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin: 0;
  }

  .photo-wrap {
    margin-bottom: 2rem;
  }

  .photo-placeholder {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .photo-placeholder span {
    font-size: 0.625rem;
    color: var(--color-muted);
    text-align: center;
    padding: 0.5rem;
    line-height: 1.3;
  }

  .bio {
    margin-bottom: 3rem;
  }

  .bio p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  h2 {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin: 0 0 1.5rem;
  }

  .timeline {
    margin-bottom: 3rem;
  }

  .timeline-item {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    position: relative;
  }

  .timeline-marker {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 0.4rem;
  }

  .timeline-content {
    flex: 1;
  }

  .timeline-header {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .company {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .period {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .timeline-content p {
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.65;
    margin: 0;
  }

  .contact {
    margin-bottom: 0;
  }

  .contact p {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.65;
    margin: 0 0 1rem;
  }

  .contact ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.25rem;
  }

  .contact li a {
    font-size: 0.875rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  .contact li a:hover {
    text-decoration: underline;
  }
</style>
