---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EssayCard from '../components/EssayCard.astro';

const recentEssays = (await getCollection('essays', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <div class="container">
    <!-- Hero -->
    <section class="hero">
      <h1>Trey Knowles</h1>
      <p class="tagline">Go-to-market for devtools.</p>
      <p class="bio">
        I help developer-focused companies find their first customers and build the repeatable
        motions that scale. Previously early GTM at <a href="https://vercel.com" target="_blank" rel="noopener">Vercel</a>
        and <a href="https://laravel.com" target="_blank" rel="noopener">Laravel</a>.
      </p>
      <nav class="hero-nav">
        <a href="/about">About</a>
        <a href="/essays">Essays</a>
        <a href="/projects">Projects</a>
        <a href="/favorites">Favorites</a>
      </nav>
    </section>

    <!-- Recent Essays -->
    {recentEssays.length > 0 && (
      <section class="recent">
        <div class="section-header">
          <h2>Recent Essays</h2>
          <a href="/essays">All essays →</a>
        </div>
        {recentEssays.map(essay => (
          <EssayCard
            title={essay.data.title}
            description={essay.data.description}
            date={essay.data.date}
            slug={essay.id}
            tags={essay.data.tags}
          />
        ))}
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 720px;
    margin: 0 auto;
    padding: 4rem 1.5rem 4rem;
  }

  .hero {
    margin-bottom: 4rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--color-text);
    margin: 0 0 0.25rem;
  }

  .tagline {
    font-size: 1.125rem;
    color: var(--color-muted);
    margin: 0 0 1.25rem;
    font-weight: 400;
  }

  .bio {
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.7;
    max-width: 560px;
    margin: 0 0 1.75rem;
  }

  .bio a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .bio a:hover {
    text-decoration: underline;
  }

  .hero-nav {
    display: flex;
    gap: 0.125rem;
    flex-wrap: wrap;
    margin: 0 -0.5rem;
  }

  .hero-nav a {
    font-size: 0.875rem;
    color: var(--color-muted);
    text-decoration: none;
    padding: 0.375rem 0.5rem;
    border-radius: 0.375rem;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .hero-nav a:hover {
    color: var(--color-text);
    background-color: var(--color-bg-subtle);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  h2 {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin: 0;
  }

  .section-header a {
    font-size: 0.8125rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .section-header a:hover {
    color: var(--color-text);
  }
</style>
