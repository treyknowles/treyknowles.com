---
import { getCollection, render } from 'astro:content';
import EssayLayout from '../../layouts/EssayLayout.astro';

export async function getStaticPaths() {
  const thoughts = await getCollection('thoughts', ({ data }) => !data.draft);
  return thoughts.map(essay => ({
    params: { slug: essay.id },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);
---

<EssayLayout
  title={essay.data.title}
  description={essay.data.description}
  date={essay.data.date}
  tags={essay.data.tags}
>
  <Content />
</EssayLayout>
